<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SpasiX</AssemblyName>
    <RootNamespace>KeystoneMT5</RootNamespace>
    <StartupObject>KeystoneMT5.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>assets\spasix.ico</ApplicationIcon>
    <Product>SpasiX</Product>
    <AssemblyTitle>SpasiX</AssemblyTitle>
    <Company>SpasiX</Company>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\spasix.png" />
  </ItemGroup>
</Project>
